# ---- AI agent (choose ONE) ----------------------------------------
# Production: your own proxy holds the key. See worker/
# VITE_AI_PROXY_URL=https://tripai-ai.<subdomain>.workers.dev

# Development: browser calls Google directly. Key ends up in the bundle.
# VITE_GEMINI_API_KEY=AIza...

# Optional. Run `npm run ai:check` to see what your key can use.
# VITE_GEMINI_MODEL=gemini-2.5-flash

# ---- Maps ---------------------------------------------------------
# Optional. Without it the app uses free, keyless CARTO tiles.
# VITE_GOOGLE_MAPS_KEY=
