# Every variable here is optional. Copy this file to .env.local and fill in
# only what you need — the app runs fully without any of them.
#
# Vite reads these ONLY at startup. Restart the dev server after editing.

# ---- AI agent (choose ONE) ----------------------------------------
# Production: your own proxy holds the key server-side. See worker/
# VITE_AI_PROXY_URL=https://tripai-ai.<subdomain>.workers.dev

# Development: the browser calls Google directly, so the key ends up in the
# built JS. Fine for local work, not for a public site.
# VITE_GEMINI_API_KEY=

# Optional. Run `npm run ai:check` to see what your key can actually use.
# VITE_GEMINI_MODEL=gemini-3.6-flash

# ---- Firebase (profile, trips, routes, crash log) ------------------
# From Firebase Console -> Project settings -> Your apps -> Web app config.
# Without these the app stores everything in localStorage instead.
# VITE_FB_API_KEY=
# VITE_FB_AUTH_DOMAIN=<your-hosting-domain> — the site's own domain (e.g.
#   <project-id>.web.app), not the default *.firebaseapp.com. The default
#   causes Google sign-in to fail with "missing initial state" on browsers
#   that partition storage between origins, since the OAuth round-trip
#   crosses from the app's domain to a different one. Firebase Hosting
#   auto-provisions the real auth handler at /__/auth/** on your own domain
#   too, so this is a safe swap with no other config needed.
# VITE_FB_PROJECT_ID=
# VITE_FB_STORAGE_BUCKET=<project-id>.firebasestorage.app
# VITE_FB_SENDER_ID=
# VITE_FB_APP_ID=

# ---- Maps ---------------------------------------------------------
# Optional. Without it the app uses free, keyless CARTO tiles.
# VITE_GOOGLE_MAPS_KEY=
