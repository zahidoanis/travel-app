rules_version = '2';

// Anonymous auth gives every device a stable uid, and signing in with Google
// links that same uid rather than replacing it. So a uid identifies an
// account, not a device, once someone has signed in.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(tripId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    // ---- profile -------------------------------------------------------
    // Small: display name and which trip you are currently looking at.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- trips ---------------------------------------------------------
    // A trip belongs to its members, not to one owner, because the same
    // document has to serve someone's laptop, their phone, and everyone they
    // invited.
    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // You may only create a trip you are already a member of.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.ownerId == request.auth.uid;

      // Members may edit freely. A non-member may make exactly one change:
      // adding themselves. That is how the WhatsApp invite works — the link
      // carries the trip id and, for trips made since invite tokens exist,
      // the trip's inviteToken.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['members', 'memberIds', 'joinedWith', 'updatedAt'])
          // Only your own entry in the members map, and only as an editor.
          // Before this a joiner could rewrite every other member's role, or
          // list themselves as an owner.
          && request.resource.data.get('members', {}).diff(resource.data.get('members', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == 'editor'
          && holdsInvite()
        )
      );

      // A trip with an inviteToken can only be joined by someone holding
      // it, written under their own uid in joinedWith — per person, so
      // nobody can ride on a token an earlier joiner already stored. Any
      // member can replace the token, which is how a leaked link is
      // revoked. Trips from before tokens have none and stay joinable by id,
      // until a member resets their link.
      function holdsInvite() {
        return !('inviteToken' in resource.data)
          || request.resource.data.get('joinedWith', {}).get(request.auth.uid, '') == resource.data.inviteToken;
      }

      // Only the owner can delete, so one member cannot erase the trip for
      // everyone else.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Days, expenses and anything else nested under the trip follow the
      // trip's membership.
      //
      // The leading {sub} segment is load-bearing: a bare {document=**} here
      // also matches the trip document itself, and its `write` then grants
      // every member delete — quietly overriding the owner-only rule above,
      // because any matching allow is enough. Requiring one more path segment
      // keeps this to the subcollections.
      match /{sub}/{document=**} {
        allow read, write: if isMember(tripId);
      }
    }

    // ---- crash log -----------------------------------------------------
    // Write-only from the client: a device may report its own errors but must
    // not read them back or amend them, which keeps the log usable as
    // evidence.
    match /diagnostics/{uid}/events/{eventId} {
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.size() < 30;
      allow read, update, delete: if false;
    }

    // Anything not matched above is denied.
  }
}
